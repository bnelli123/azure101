pipeline {
    agent any

    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'master', url: 'https://github.com/bnelli123/azure101.git'
            }

        }

        stage('Build') {
        when {
           branch 'develop'
          }
            steps {
                sh 'mvn clean install'
            }
        }
    }
}